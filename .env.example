# Copy this file to .env and fill in the values.
# The application loads OpenAI credentials from the environment.
OPENAI_API_KEY=

# The portal URL used by the agent if it posts detected alerts back to the web service.
PORTAL_URL=http://127.0.0.1:5000

# Gmail OAuth credentials must be stored in credentials.json.
# The OAuth token will be created or refreshed in token.json.
